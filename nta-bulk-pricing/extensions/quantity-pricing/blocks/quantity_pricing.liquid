{% assign pricing_product = block.settings.product | default: product %}
{% if pricing_product %}
  <div
    class="nta-bulk-pricing"
    data-nta-bulk-pricing
    data-endpoint="/apps/nta-bulk-pricing"
    data-product-id="{{ pricing_product.id }}"
    data-variant-id="{{ pricing_product.selected_or_first_available_variant.id }}"
    data-collection-ids="{% for collection in pricing_product.collections %}{{ collection.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
    data-heading="{{ block.settings.heading | escape }}"
    data-show-rule-name="{{ block.settings.show_rule_name }}"
    style="--nta-bulk-pricing-accent: {{ block.settings.accent_colour }}"
    {{ block.shopify_attributes }}
    hidden
  >
    <div class="nta-bulk-pricing__content" aria-live="polite"></div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Quantity pricing",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "quantity-pricing.css",
  "javascript": "quantity-pricing.js",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bulk pricing" },
    { "type": "checkbox", "id": "show_rule_name", "label": "Show offer name", "default": false },
    { "type": "color", "id": "accent_colour", "label": "Accent colour", "default": "#17643a" }
  ]
}
{% endschema %}
